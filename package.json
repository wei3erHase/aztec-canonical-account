{
  "name": "@defi-wonderland/canonical-wallet",
  "version": "4.0.0-devnet.2-patch.1",
  "repository": "https://github.com/defi-wonderland/canonical-wallet.git",
  "author": "Wonderland",
  "license": "MIT",
  "type": "module",
  "main": "dist/ts/index.js",
  "types": "dist/ts/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/ts/index.d.ts",
      "import": "./dist/ts/index.js"
    },
    "./schnorr-account": {
      "types": "./dist/ts/schnorr-account/index.d.ts",
      "import": "./dist/ts/schnorr-account/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf ./src/artifacts ./target codegenCache.json dist",
    "codegen": "aztec codegen target --outdir src/artifacts -f",
    "compile": "aztec compile",
    "test": "yarn test:nr && yarn test:js",
    "test:js": "vitest run",
    "test:nr": "aztec test",
    "lint:prettier": "prettier '**/*.{js,ts}' --write",
    "ccc": "yarn clean && yarn compile && yarn codegen",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts}": "prettier --write -u"
  },
  "dependencies": {
    "@aztec/accounts": "4.0.0-devnet.2-patch.1",
    "@aztec/aztec.js": "4.0.0-devnet.2-patch.1",
    "@aztec/entrypoints": "4.0.0-devnet.2-patch.1",
    "@aztec/noir-contracts.js": "4.0.0-devnet.2-patch.1",
    "@aztec/pxe": "4.0.0-devnet.2-patch.1",
    "@aztec/stdlib": "4.0.0-devnet.2-patch.1",
    "@aztec/wallets": "4.0.0-devnet.2-patch.1",
    "@types/node": "25.0.2"
  },
  "devDependencies": {
    "@commitlint/cli": "20.2.0",
    "@commitlint/config-conventional": "20.2.0",
    "husky": "9.1.7",
    "lint-staged": "16.3.2",
    "prettier": "3.8.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  },
  "config": {
    "aztecVersion": "4.0.0-devnet.2-patch.1"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e",
  "engines": {
    "node": ">=22.0.0",
    "yarn": ">=1.22.0"
  },
  "resolutions": {
    "@noble/hashes": "1.8.0"
  }
}
